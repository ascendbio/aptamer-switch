#!/bin/bash
# Launch the app (no args) or the agent CLI (with a biomarker).
#
# Needs a Python 3.12 environment with ViennaRNA, gradio and claude-agent-sdk.
# Set APTAMER_PY to point at it; otherwise a few usual locations are tried, so a
# teammate with a different layout does not have to edit this file.
set -e
cd "$(dirname "$0")"

case "${1:-}" in
  -h|--help)
    cat <<'USAGE'
Aptamer switch design for continuous biosensors.

  ./run                 launch the web UI on http://localhost:7860
  ./run --share         also publish a password-protected public link (72h)
  ./run "IL-6"          run the agent for one biomarker, output to the terminal
  ./run --demo-results  write simulated wet-lab data matching your newest plate
  ./run --help          this message

--share tunnels to THIS machine. The agent runs here and spends this machine's
Claude session, Paperclip account and Modal credits, so the link is always
password protected. Set APTAMER_PASSWORD to choose the password.

Needs Python 3.12 with ViennaRNA, gradio and claude-agent-sdk:
  python3.12 -m venv venv && ./venv/bin/pip install -r requirements.txt

Set APTAMER_PY to choose the interpreter explicitly.
Literature search needs the `paperclip` CLI on PATH; the design pipeline does
not, and runs offline:
  ./venv/bin/python sources/design.py
USAGE
    exit 0 ;;
esac

CANDIDATES=(
  "$APTAMER_PY"
  "$HOME/Documents/AscendBiosci/hackathon-mcp/venv/bin/python"
  "./venv/bin/python"
  "$(command -v python3.12 || true)"
)
for py in "${CANDIDATES[@]}"; do
  [ -n "$py" ] && [ -x "$py" ] && "$py" -c "import RNA, gradio" 2>/dev/null && VENV="$py" && break
done

if [ -z "${VENV:-}" ]; then
  echo "No suitable Python found. Create one:" >&2
  echo "  python3.12 -m venv venv && ./venv/bin/pip install -r requirements.txt" >&2
  echo "Or set APTAMER_PY to an interpreter that has ViennaRNA and gradio." >&2
  exit 1
fi

case "${1:-}" in
  --demo-results) exec "$VENV" sources/feedback.py ;;
  --share) APTAMER_SHARE=1 exec "$VENV" app.py ;;
  "")      exec "$VENV" app.py ;;
  *)       exec "$VENV" agent.py "$@" ;;
esac
